{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "_site"
  },
  "include": ["js/**/*.ts"]
}
